<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JulieAgent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK novo do Microsoft Foundry - usa Azure.AI.Projects + OpenAI Responses API -->
    <!-- As APIs de implantação a partir do código-fonte para agentes hospedados só existem na linha prerelease. -->
    <PackageReference Include="Azure.AI.Projects" Version="3.0.0-beta.2" />
    <PackageReference Include="Azure.AI.Projects.Agents" Version="3.0.0-beta.2" />
    <PackageReference Include="Azure.AI.Extensions.OpenAI" Version="3.0.0-beta.2" />
    <!-- Azure.Identity é omitido de propósito: Azure.Core 1.53 já inclui seus tipos de credencial. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="db-structure.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
