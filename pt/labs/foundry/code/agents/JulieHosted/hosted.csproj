<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>julie-hosted</AssemblyName>
    <RootNamespace>JulieHosted</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- O hosting do Agent Framework exige Azure.AI.Projects 3.x; o 2.1.0-beta.4 do quickstart é anterior. -->
    <PackageReference Include="Azure.AI.Projects" Version="3.0.0-beta.2" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry" Version="1.22.0-preview.260918.1" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="1.22.0-preview.260918.1" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.22.0" />
  </ItemGroup>

</Project>
