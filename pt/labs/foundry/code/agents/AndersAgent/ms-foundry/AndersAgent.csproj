<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AndersAgent.MsFoundry</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK nuevo de Microsoft Foundry - usa Azure.AI.Projects + OpenAI Responses API -->
    <!-- API nova de Foundry projects. A linha 1.x é Foundry classic e não é compatível. -->
    <PackageReference Include="Azure.AI.Projects" Version="2.0.1" />
    <PackageReference Include="Azure.AI.Projects.Agents" Version="2.0.0" />
    <PackageReference Include="Azure.AI.Extensions.OpenAI" Version="2.0.0" />
    <!-- Azure.Identity é omitido de propósito: Azure.Core 1.53 já inclui seus tipos de credencial. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
