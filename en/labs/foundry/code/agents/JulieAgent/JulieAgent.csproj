<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JulieAgent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK nuevo de Microsoft Foundry - usa Azure.AI.Projects + OpenAI Responses API -->
    <!-- Source-code deployment APIs for hosted agents ship only in the prerelease line. -->
    <PackageReference Include="Azure.AI.Projects" Version="3.0.0-beta.2" />
    <PackageReference Include="Azure.AI.Projects.Agents" Version="3.0.0-beta.2" />
    <PackageReference Include="Azure.AI.Extensions.OpenAI" Version="3.0.0-beta.2" />
    <!-- Azure.Identity is intentionally absent: Azure.Core 1.53 ships the Azure.Identity credential types. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="db-structure.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
