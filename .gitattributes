# Normalize line endings across platforms
* text=auto

# Shell scripts must always use LF (they run in Linux/Codespaces/Git Bash)
*.sh text eol=lf

# PowerShell scripts use CRLF on Windows
*.ps1 text eol=crlf

# codespaces-setup names the working branch per-branch (master vs one-day);
# keep each branch's own version on merge so it never conflicts.
en/labs/foundry/codespaces-setup.md merge=ours
es/labs/foundry/codespaces-setup.md merge=ours
pt/labs/foundry/codespaces-setup.md merge=ours
